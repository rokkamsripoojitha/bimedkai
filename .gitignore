# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Data and large artifacts (keep structure, exclude large model weights and full cache)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/graph/*
!data/graph/.gitkeep

# Checkpoints and logs
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# HuggingFace Cache
.cache/
hf_cache/

# OS specific
.DS_Store
Thumbs.db
